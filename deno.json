{
  "name": "@sobanieca/sqlr",
  "description": "CLI tool for interacting with SQL databases",
  "version": "0.8.0",
  "license": "MIT",
  "exports": "./main.js",
  "compilerOptions": {
    "checkJs": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "noImplicitThis": false
  },
  "fmt": {
    "include": [".", "test/"]
  },
  "lint": {
    "include": [".", "test/"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "run": "deno run --allow-all main.js",
    "check": "deno fmt --check && deno lint && deno check main.js && deno check test/test_*.js && cd test && deno task test",
    "start-db": "bash test/start-db.sh",
    "stop-db": "docker compose -f test/docker-compose.yml down"
  }
}
