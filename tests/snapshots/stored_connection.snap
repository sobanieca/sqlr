$ sqlr add -n world -t postgresql -s "postgres://localhost:5432/world-db?user=world&password=world123&application_name=sqlr" -c blue -e "📦"
exit code: 0
--- stdout
Connection has been added
--- stderr

$ sqlr ls
exit code: 0
