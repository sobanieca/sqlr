  --debug                                       - Enable debug logs                                                                      
  -q, --query              [query]              - SQL query to be executed                       (Default: "")                           
  -i, --input-file         [input-file]         - Path to input file containing SQL query                                                
  -o, --output-file        [output-file]        - Output file where JSON results will be stored                                          
