{
  "compilerOptions": {
    "checkJs": true,
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "test": "deno test -A --parallel --fail-fast test_*.js",
    "update-snapshots": "deno test -A --parallel --fail-fast test_*.js -- --update"
  }
}
